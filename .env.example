# Obtén estos valores con `supabase status` después de `supabase start`.
# Usa la IP/host que tu Docker pueda alcanzar, NO 127.0.0.1 (eso apunta
# al contenedor mismo, no a tu PC). En Windows/Mac con Docker Desktop,
# host.docker.internal funciona.
SUPABASE_URL=http://host.docker.internal:54321

# Es la llave "Secret" (sb_secret_...) que muestra `supabase status`.
# Reemplaza a la antigua service_role key; se usa igual en el código.
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-tu-sb_secret_...

# Secreto compartido entre api/.env y el proceso vision_module.
# Genera uno propio; no reutilices ni publiques este valor.
VISION_STREAM_TOKEN=reemplaza-por-un-secreto-aleatorio-largo
